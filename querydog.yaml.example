environments:
  - name: "Production"
    host: ""
    port: 8443
    user: "default"
    password: ""
    database: "default"
    secure: true
    # Optional: cluster name for clusterAllReplicas() queries
    # cluster: "default"
    # Optional: custom queries folder path
    # queries_folder: "queries"

  - name: "Test"
    host: "localhost"
    port: 8123
    user: "default"
    password: ""
    database: "default"
