CLICKHOUSE_HOST=your-clickhouse-host.cloud
CLICKHOUSE_USER=your-username
CLICKHOUSE_DATABASE=your-database
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_SECURE=1
CLICKHOUSE_PORT=8443

# Optional: Set to 0 to allow self-signed certificates (not recommended for production)
# CLICKHOUSE_TLS_REJECT_UNAUTHORIZED=1

# Optional: Set cluster name to query all replicas using clusterAllReplicas()
# If not set, queries will only target the single connected node
# CLICKHOUSE_CLUSTER=default

# Optional: Override the queries folder location (default: queries)
# QUERYDOG_QUERIES_FOLDER=queries
